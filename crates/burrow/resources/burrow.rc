1 ICON "burrow.ico"

// File properties and the name Windows shows (Task Manager, SmartScreen).
// build.rs fills in VER_* from Cargo.toml.
1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Burrow"
      VALUE "FileDescription", "Burrow"
      VALUE "FileVersion", VER_STRING
      VALUE "InternalName", "burrow"
      VALUE "LegalCopyright", "MPL-2.0"
      VALUE "OriginalFilename", "burrow.exe"
      VALUE "ProductName", "Burrow"
      VALUE "ProductVersion", VER_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
